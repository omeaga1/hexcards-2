{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hex Cards",
  "version": "0.2.2",
  "identifier": "com.omeaga1.hexcards",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Hex Cards",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://ddragon.leagueoflegends.com https://raw.communitydragon.org; connect-src 'self' ipc: http://ipc.localhost https://ddragon.leagueoflegends.com https://raw.communitydragon.org https://omeaga1.github.io; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Hex Cards",
    "homepage": "https://omeaga1.github.io/hexcards-2/",
    "shortDescription": "League of Legends builds from ranked games, imported into the client",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVGREUzRjg4RjgxNkIxMTQKUldRVXNSYjRpRC9lNzFFb1VQZlBiVkt4MHVFYVZMZU1JbFlYd0pza0dROGRYT1RtREtYd3Z0V3EK",
      "endpoints": [
        "https://github.com/omeaga1/hexcards-2/releases/latest/download/latest.json"
      ]
    }
  }
}
